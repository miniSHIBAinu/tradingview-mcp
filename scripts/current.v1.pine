//@version=6
indicator("Consensus Dashboard", overlay=true, max_boxes_count=50, max_labels_count=50)

// === INPUTS ===
grpBias = "Bias Settings"
htfRes     = input.timeframe("D", "HTF Resolution", group=grpBias)
voteThresh = input.int(60, "Confidence Threshold %", minval=50, maxval=90, group=grpBias)

grpRisk = "Risk Settings"
atrLen = input.int(20, "ATR Length", group=grpRisk)
slMult = input.float(1.5, "SL Multiplier (ATR)", step=0.1, group=grpRisk)
tpMult = input.float(3.0, "TP Multiplier (ATR)", step=0.1, group=grpRisk)

// === HTF BIAS ===
htfClose = request.security(syminfo.tickerid, htfRes, close, barmerge.gaps_off, barmerge.lookahead_off)
htfEma50 = request.security(syminfo.tickerid, htfRes, ta.ema(close, 50), barmerge.gaps_off, barmerge.lookahead_off)
htfBull  = htfClose > htfEma50

// === TF BIAS (EMA alignment) ===
ema9   = ta.ema(close, 9)
ema21  = ta.ema(close, 21)
ema50  = ta.ema(close, 50)
tfBull = ema9 > ema21 and ema21 > ema50
tfBear = ema9 < ema21 and ema21 < ema50

// === STRUCTURE (BOS via confirmed pivots) ===
pivHi = ta.pivothigh(high, 1, 1)
pivLo = ta.pivotlow(low, 1, 1)
var float lastHi = na
var float lastLo = na
if not na(pivHi)
    lastHi := pivHi
if not na(pivLo)
    lastLo := pivLo

bosUp = not na(lastHi[1]) and close > lastHi[1] and close[1] <= lastHi[1]
bosDn = not na(lastLo[1]) and close < lastLo[1] and close[1] >= lastLo[1]

// === FVG (3-bar gap) ===
fvgBull = low > high[2]
fvgBear = high < low[2]

// === ABSORPTION (vol spike + small body) ===
atrVal    = ta.atr(atrLen)
volAvg    = ta.sma(volume, 20)
volSpike  = volume > volAvg * 1.5
smallBody = (high - low) < atrVal * 0.5
absBull   = volSpike and close > open and smallBody
absBear   = volSpike and close < open and smallBody

// === SESSION ===
isNY = hour >= 13 and hour < 21

// === VOTING ===
var int votes = 0
var int total = 0
votes := 0
total := 0

if htfBull
    votes += 1
total += 1

if tfBull
    votes += 1
else if tfBear
    votes -= 1
total += 1

if bosUp
    votes += 1
else if bosDn
    votes -= 1
total += 1

if fvgBull
    votes += 1
else if fvgBear
    votes -= 1
total += 1

if absBull
    votes += 1
else if absBear
    votes -= 1
total += 1

if isNY
    votes += 1
    total += 1

confidence   = total > 0 ? math.round((votes / total) * 100, 0) : 0
absConf      = math.abs(confidence)
bias         = absConf >= voteThresh ? (votes > 0 ? "LONG" : "SHORT") : "NEUTRAL"

// === RISK LEVELS ===
slLong  = close - atrVal * slMult
tpLong  = close + atrVal * tpMult
slShort = close + atrVal * slMult
tpShort = close - atrVal * tpMult

// === TABLE ===
var table dash = table.new(position.top_right, 2, 8, border_width=1, border_color=color.gray)
if barstate.islast
    bg = bias == "LONG" ? color.new(color.green, 80) : bias == "SHORT" ? color.new(color.red, 80) : color.new(color.gray, 80)
    table.cell(dash, 0, 0, "BIAS",          bgcolor=color.gray, text_color=color.white)
    table.cell(dash, 1, 0, bias,            bgcolor=bg,         text_color=color.white)
    table.cell(dash, 0, 1, "Confidence",    bgcolor=color.gray, text_color=color.white)
    table.cell(dash, 1, 1, str.tostring(confidence) + "%")
    table.cell(dash, 0, 2, "Price",         bgcolor=color.gray, text_color=color.white)
    table.cell(dash, 1, 2, str.tostring(close, "#.#####"))
    table.cell(dash, 0, 3, "HTF (1D)",      bgcolor=color.gray, text_color=color.white)
    table.cell(dash, 1, 3, htfBull ? "↑ Bull" : "↓ Bear")
    table.cell(dash, 0, 4, "TF EMA",        bgcolor=color.gray, text_color=color.white)
    table.cell(dash, 1, 4, tfBull ? "Bull align" : tfBear ? "Bear align" : "Mixed")
    table.cell(dash, 0, 5, "ATR",           bgcolor=color.gray, text_color=color.white)
    table.cell(dash, 1, 5, str.tostring(atrVal, "#.#####"))
    table.cell(dash, 0, 6, "SL / TP Long",  bgcolor=color.gray, text_color=color.white)
    table.cell(dash, 1, 6, str.tostring(slLong, "#.#####") + " / " + str.tostring(tpLong, "#.#####"))
    table.cell(dash, 0, 7, "SL / TP Short", bgcolor=color.gray, text_color=color.white)
    table.cell(dash, 1, 7, str.tostring(slShort, "#.#####") + " / " + str.tostring(tpShort, "#.#####"))
