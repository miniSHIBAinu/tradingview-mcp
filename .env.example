# ==============================================================================
# TradingView MCP (TDV-MCP) Environment Configuration
# Copy this file to .env or /etc/tdv-mcp/tdv-mcp.env and update values.
# ==============================================================================

# --- Node Environment ---
NODE_ENV=production

# --- Streamable HTTP Server Configuration ---
TV_HTTP_HOST=127.0.0.1
TV_HTTP_PORT=3000

# --- Authentication ---
# Bearer token required for all incoming MCP requests. Generate a strong random token:
# Linux/Mac/Git Bash: openssl rand -hex 32
# PowerShell: [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
TDV_MCP_AUTH_TOKEN=change_me_to_a_secure_random_token

# --- TradingView CDP Connection ---
# Targets loopback on the VPS where the reverse SSH bridge forwards traffic to PC.
# Note (session 8): When running TV Desktop locally on Windows, it defaults to
# port 9222 (the Chrome DevTools port), NOT 9333. Set TV_CDP_PORT=9222 if you
# launched TV with --remote-debugging-port=9222.
TV_CDP_HOST=127.0.0.1
TV_CDP_PORT=9222
